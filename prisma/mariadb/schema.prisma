generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@internal/prisma/mariadb-client"
}

datasource db {
  provider = "mysql"
  url      = env("MARIADB_URL")
}

model SyncedTask {
  id         Int      @id
  title      String
  expression String
  syncedAt   DateTime @default(now())
}

model SyncedUser {
  id        Int      @id
  email     String   @unique
  password  String
  name      String
  phone     String   @unique
  role      String
  createdAt DateTime
  updatedAt DateTime
  syncedAt  DateTime @default(now())
}
